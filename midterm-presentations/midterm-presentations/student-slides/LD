Holiday weeks have \~9% fewer crashes and AICc improves by 10.

Passes Ljung-Box test

Forecasts use the base ARIMA for comparison with the state space

## Fitting the ARIMA used for forecasting

```{r}
#| echo: true
y  <- log(total$n_crashes); n <- length(y); tt <- 1:n
fit_trend <- Arima(y, order = c(0, 1, 1),
                   seasonal = list(order = c(1, 0, 0), period = 52), xreg = tt)
fit_trend
```

## Is there a trend? (ARIMA)

```{r}
#| echo: true
b  <- coef(fit_trend)[["xreg"]]
se <- sqrt(diag(vcov(fit_trend)))[["xreg"]]
ann <- 100 * (exp(52.18 * (b + c(est = 0, lo = -1.96, hi = 1.96) * se)) - 1)
round(ann, 1)   # annual % change with 95% CI
```

## State-space fit

```{r}
#| echo: true
y  <- log(total$n_crashes); m <- 52
Phi <- matrix(0, m, m); Phi[1, 1] <- 1; Phi[2, 2:m] <- -1
for (i in 3:m) Phi[i, i - 1] <- 1
A  <- matrix(c(1, 1, rep(0, m - 2)), nrow = 1)
mu0 <- c(mean(y[1:4]), rep(0, m - 1)); Sigma0 <- diag(c(1, rep(0.1, m - 1)))
mkQ <- function(p) { Q <- diag(0, m); Q[1, 1] <- exp(p[1]); Q[2, 2] <- exp(p[2]); Q }

nll  <- function(p, yy) Kfilter(yy, A, mu0, Sigma0, Phi, mkQ(p), exp(p[3]))$like
est0 <- optim(log(c(0.03, 0.01, 0.05)), nll, yy = y, method = "BFGS")
setNames(exp(est0$par), c("sd_level", "sd_season", "sd_obs"))
```

The variance of observation noise (week-to-week randomness) dominates at about 3.5% per week. The level and seasonal variances are around 1.3% per week each, suggesting a slow drift rather than staying fixed.

## Smoothed trend

```{r}
ks <- Ksmooth(y, A, mu0, Sigma0, Phi, mkQ(est0$par), exp(est0$par[3]))
level <- as.numeric(ks$Xs[1, , ]); season <- as.numeric(ks$Xs[2, , ])
se_lvl <- sqrt(ks$Ps[1, 1, ]); dates <- total$week

ggplot(tibble(dates, actual = total$n_crashes, trend = exp(level), fit = exp(level + season),
              lo = exp(level - 1.96 * se_lvl), hi = exp(level + 1.96 * se_lvl)), aes(dates)) +
  geom_line(aes(y = actual), colour = "grey65") +
  geom_ribbon(aes(ymin = lo, ymax = hi), fill = "firebrick", alpha = .2) +
  geom_line(aes(y = trend), colour = "firebrick", linewidth = 1.2) +
  geom_line(aes(y = fit), colour = "steelblue", linetype = 2) +
  labs(x = NULL, y = "Crashes / week",
       title = "Smoothed trend (red, 95% band) and trend + seasonal (blue, dashed)")
```

## Is there a trend? (state space)

```{r}
#| echo: true
first_lvl <- mean(level[1:13]); last_lvl <- mean(tail(level, 13))
tibble(start = exp(first_lvl), end = exp(last_lvl),
       pct_change = round(100 * (exp(last_lvl - first_lvl) - 1), 1))

se_first <- sqrt(mean(ks$Ps[1, 1, 1:13]))
se_last  <- sqrt(mean(tail(ks$Ps[1, 1, ], 13)))
se_diff  <- sqrt(se_first^2 + se_last^2)
d <- last_lvl - first_lvl
round(100 * (exp(d + c(est = 0, lo = -1.96, hi = 1.96) * se_diff) - 1), 1)
```

State Space model predicts a smoothed decrease in number of crashes to be approximately 15% from January 2021 to December 2025 (\~3% drop per year). Both models predict a decreasing trend in the number of crashes.

# Borough Effect

## Estimated Borough Effect (ARIMA)

```{r}

boro_ts <- wk |>
  filter( week > as.Date("2021-01-01"), week < as.Date("2026-01-01")) |>
  mutate(week = yearweek(week)) |>
  as_tsibble(index = week, key = borough)

fit_b <- boro_ts |>
  model(ARIMA(log(n_crashes) ~ trend() + pdq(0, 1, 1) + PDQ(1, 0, 0)))

boro_trend <- tidy(fit_b) |>
  filter(term == "trend()") |>
  transmute(borough,
            annual_pct = 100 * (exp(52.18 * estimate) - 1),
            lo = 100 * (exp(52.18 * (estimate - 1.96 * std.error)) - 1),
            hi = 100 * (exp(52.18 * (estimate + 1.96 * std.error)) - 1))
ggplot(boro_trend, aes(annual_pct, reorder(borough, annual_pct))) +
  geom_pointrange(aes(xmin = lo, xmax = hi)) +
  geom_vline(xintercept = 0, linetype = 2) +
  labs(x = "Annual % change in weekly crashes (95% CI)", y = NULL,
       title = "Does every borough share the citywide trend?")
```

## Borough Effect (state space)

```{r}
wk_win <- wk |> filter(week > as.Date("2021-01-01"), week < as.Date("2026-01-01"))
boros  <- unique(wk_win$borough)
get_y  <- function(b) log(wk_win$n_crashes[wk_win$borough == b])

fit_ss <- function(yl) {
  mu0 <- c(mean(yl[1:4]), rep(0, m - 1)); s <- sd(diff(yl))
  f <- function(p) Kfilter(yl, A, mu0, Sigma0, Phi, mkQ(p), exp(p[3]))$like
  est <- optim(log(c(.3, .1, .5) * s), f, method = "BFGS", control = list(maxit = 500))
  ks <- Ksmooth(yl, A, mu0, Sigma0, Phi, mkQ(est$par), exp(est$par[3]))
  list(level = ks$Xs[1, , ], se = sqrt(ks$Ps[1, 1, ]))
}
res <- map(set_names(boros), \(b) fit_ss(get_y(b)))
bdates <- sort(unique(wk_win$week))

plot_df <- imap_dfr(res, \(f, b) tibble(
  borough = b, date = bdates, actual = exp(get_y(b)), trend = exp(f$level),
  lo = exp(f$level - 1.96 * f$se), hi = exp(f$level + 1.96 * f$se)))

ggplot(plot_df, aes(date)) +
  geom_line(aes(y = actual), colour = "grey65") +
  geom_ribbon(aes(ymin = lo, ymax = hi), fill = "firebrick", alpha = .2) +
  geom_line(aes(y = trend), colour = "firebrick", linewidth = 1) +
  facet_wrap(~borough, scales = "free_y", ncol = 3) + labs(x = NULL, y = "Crashes / week")
```

