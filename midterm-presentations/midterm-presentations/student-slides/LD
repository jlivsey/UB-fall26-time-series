# Forecasting

## Holdout forecasts (26 weeks into 2026)

```{r}
H <- 26; n <- length(y)
fc <- forecast(fit_trend, xreg = (n + 1):(n + H), h = H, level = 95)

# state-space forecast
kf <- Kfilter(y, A, mu0, Sigma0, Phi, mkQ(est0$par), exp(est0$par[3]))
x <- matrix(kf$Xf[, , n], ncol = 1); P <- kf$Pf[, , n]
Q <- mkQ(est0$par)^2; R <- exp(est0$par[3])^2
ss <- t(sapply(1:H, \(h) {
  x <<- Phi %*% x; P <<- Phi %*% P %*% t(Phi) + Q
  mu <- drop(A %*% x); v <- drop(A %*% P %*% t(A)) + R
  c(pred = mu, lo = mu - 1.96 * sqrt(v), hi = mu + 1.96 * sqrt(v))
}))

fdates <- max(total$week) + 7 * (1:H)
all_fc <- bind_rows(
  tibble(week = fdates, model = "ARIMA", pred = exp(as.numeric(fc$mean)),
         lo = exp(as.numeric(fc$lower)), hi = exp(as.numeric(fc$upper))),
  tibble(week = fdates, model = "State space", pred = exp(ss[, "pred"]),
         lo = exp(ss[, "lo"]), hi = exp(ss[, "hi"]))) |>
  left_join(total_all, by = "week")

hist_df <- total |> filter(week > max(week) - 7 * 52)
ggplot() +
  geom_line(data = hist_df, aes(week, n_crashes), colour = "grey60") +
  geom_ribbon(data = all_fc, aes(week, ymin = lo, ymax = hi, fill = model), alpha = .15) +
  geom_line(data = all_fc, aes(week, pred, colour = model), linewidth = 1) +
  geom_line(data = filter(all_fc, model == "ARIMA"), aes(week, n_crashes), linewidth = .9) +
  labs(x = NULL, y = "Crashes / week", colour = NULL, fill = NULL,
       subtitle = "Black = actual; shaded = 95% prediction intervals") +
  theme(legend.position = "bottom")
```

## Holdout accuracy

```{r}
all_fc |> filter(!is.na(n_crashes)) |> group_by(model) |>
  summarise(weeks = n(), RMSE = sqrt(mean((n_crashes - pred)^2)),
            MAE = mean(abs(n_crashes - pred)),
            MAPE = 100 * mean(abs(n_crashes - pred) / n_crashes),
            bias = mean(pred - n_crashes),
            coverage = mean(n_crashes >= lo & n_crashes <= hi),
            width = mean(hi - lo)) |>
  mutate(across(where(is.numeric), \(x) round(x, 2))) |> knitr::kable()
```

## Rolling-origin cross-validation

Re-fit both models at several forecast origins (parameters re-estimated for ARIMA, variances held fixed for the state space) and score horizons $h=1,4,13,26$.

```{r}
#| echo: true
origins <- seq(n - 130, n - 26, by = 13); hs <- c(1, 4, 13, 26)

cv <- map_dfr(origins, \(o) {
  yt <- y[1:o]
  fa <- tryCatch(forecast(Arima(yt, order = c(0, 1, 1),
          seasonal = list(order = c(1, 0, 0), period = 52), xreg = 1:o),
          xreg = (o + 1):(o + 26), h = 26)$mean, error = \(e) rep(NA, 26))
  k <- Kfilter(yt, A, c(mean(yt[1:4]), rep(0, m - 1)), Sigma0, Phi,
               mkQ(est0$par), exp(est0$par[3]))
  xs <- matrix(k$Xf[, , o], ncol = 1)
  fs <- sapply(1:26, \(h) { xs <<- Phi %*% xs; drop(A %*% xs) })
  tibble(h = hs, actual = y[o + hs], ARIMA = as.numeric(fa)[hs], `State space` = fs[hs])
}) |> pivot_longer(c(ARIMA, `State space`), names_to = "model", values_to = "pred")

cv |> group_by(model, h) |>
  summarise(RMSE = sqrt(mean((exp(actual) - exp(pred))^2, na.rm = TRUE)),
            MAPE = 100 * mean(abs(exp(actual) - exp(pred)) / exp(actual), na.rm = TRUE),
            .groups = "drop") |>
  pivot_wider(names_from = model, values_from = c(RMSE, MAPE)) |>
  mutate(across(where(is.numeric), \(x) round(x, 1))) |> knitr::kable()
```

# Conclusions

## Takeaways

- **Trend answer:** ARIMA predicted our trend/drift coefficient to be a decrease of 2% of crashes per year. State-space level declined by an overall 15% from 2021 to 2025.
- **Model comparison:** State Space Model outperformed ARIMA for h = 1 and 26 while ARIMA slightly edged out State Space for h = 4 and 13
- **Practical use:** weekly crash forecasts for police staffing
- **Caveats:** the Apr 2020 reporting change, borough "UNKNOWN" records, and no weather or traffic/holiday covariates yet.
